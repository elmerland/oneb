---
interface Props {
	date: Date;
}
const { date } = Astro.props;
// Use UTC methods — ISO date strings are parsed as UTC midnight,
// so local getDate() can shift to the previous day in negative-offset timezones.
const year  = date.getUTCFullYear();
const month = String(date.getUTCMonth() + 1).padStart(2, '0');
const day   = String(date.getUTCDate()).padStart(2, '0');
---

<time datetime={date.toISOString()}>{year} · {month} · {day}</time>
