---
import { render } from 'astro:content';
import { getPublishedPosts } from '../lib/blog';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { DISCOURSE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await Promise.all(
  (await getPublishedPosts())
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map(async (post) => ({ post, Content: (await render(post)).Content }))
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="page" id="main-content">
      <div class="posts">
        {posts.map(({ post, Content }, i) => (
          <>
            {i > 0 && (
              <div class="pop-rule">
                <span class="seg a"></span>
                <span class="seg b"></span>
                <span class="seg c"></span>
                <span class="seg d"></span>
                <span class="seg e"></span>
              </div>
            )}
            <article class="post" data-embed-url={new URL(`/blog/${post.id}/`, Astro.site).href}>
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`} class="t-text">{post.data.title}</a>
              </h2>
              <div class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </div>
              <div class="post-body prose">
                <Content />
              </div>
              <div class="post-footer">
                <a href={`/blog/${post.id}/#discourse-comments`} class="discussion-link">Discussion</a>
              </div>
            </article>
          </>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>

<script define:vars={{ DISCOURSE_URL }}>
  (async () => {
    const articles = document.querySelectorAll('[data-embed-url]');
    if (!articles.length) return;

    const urls = [...articles].map((el) => el.dataset.embedUrl);
    const params = urls.map((u) => `embed_url[]=${encodeURIComponent(u)}`).join('&');

    try {
      const res = await fetch(`${DISCOURSE_URL}/embed/count.json?${params}`);
      if (!res.ok) return;
      const data = await res.json();
      const counts = data.counts || {};

      for (const article of articles) {
        const url = article.dataset.embedUrl;
        const count = counts[url];
        if (count && count > 3) {
          const link = article.querySelector('.discussion-link');
          if (link) link.textContent = `${count} comments`;
        }
      }
    } catch (_) {
      // silently fail — discussion links still work without counts
    }
  })();
</script>

<style>
  .discussion-link {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
  .discussion-link:hover {
    text-decoration: underline;
  }
</style>
