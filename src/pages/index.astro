---
import { render } from 'astro:content';
import { getPublishedPosts } from '../lib/blog';
import BaseHead from '../components/BaseHead.astro';
import BlogEntry from '../components/BlogEntry.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { DISCOURSE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await Promise.all(
  (await getPublishedPosts())
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map(async (post) => ({ post, Content: (await render(post)).Content }))
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="page" id="main-content">
      <div class="posts">
        {posts.map(({ post, Content }, i) => (
          <>
            {i > 0 && (
              <div class="pop-rule">
                <span class="seg a"></span>
                <span class="seg b"></span>
                <span class="seg c"></span>
                <span class="seg d"></span>
                <span class="seg e"></span>
              </div>
            )}
            <BlogEntry post={post} mode="preview">
              <Content />
            </BlogEntry>
          </>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>

<script define:vars={{ DISCOURSE_URL }}>
  (async () => {
    const articles = document.querySelectorAll('[data-embed-url]');
    if (!articles.length) return;

    const urls = [...articles].map((el) => el.dataset.embedUrl);
    const params = urls.map((u) => `embed_url[]=${encodeURIComponent(u)}`).join('&');

    try {
      const res = await fetch(`${DISCOURSE_URL}/embed/count.json?${params}`);
      if (!res.ok) return;
      const data = await res.json();
      const counts = data.counts || {};

      for (const article of articles) {
        const url = article.dataset.embedUrl;
        const count = counts[url];
        if (count && count > 3) {
          const link = article.querySelector('.discussion-link');
          if (link) link.textContent = `${count} comments`;
        }
      }
    } catch (_) {
      // silently fail — discussion links still work without counts
    }
  })();
</script>