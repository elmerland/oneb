---
import { getPublishedPosts } from '../../lib/blog';
import BaseHead from '../../components/BaseHead.astro';
import BlogEntry from '../../components/BlogEntry.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getPublishedPosts())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Archives — ${SITE_TITLE}`} description="All posts, newest first." />
  </head>
  <body>
    <Header />
    <main class="page">
      <div class="posts">
        {posts.map((post, i) => (
          <>
            {i > 0 && (
              <div class="pop-rule">
                <span class="seg a"></span>
                <span class="seg b"></span>
                <span class="seg c"></span>
                <span class="seg d"></span>
                <span class="seg e"></span>
              </div>
            )}
            <BlogEntry post={post} mode="summary" />
          </>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>