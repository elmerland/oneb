---
import { getPublishedPosts } from '../../lib/blog';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getPublishedPosts())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Archives — ${SITE_TITLE}`} description="All posts, newest first." />
  </head>
  <body>
    <Header />
    <main class="page">
      <div class="posts">
        {posts.map((post, i) => (
          <>
            {i > 0 && (
              <div class="pop-rule">
                <span class="seg a"></span>
                <span class="seg b"></span>
                <span class="seg c"></span>
                <span class="seg d"></span>
                <span class="seg e"></span>
              </div>
            )}
            <article class="post">
              <h2 class="post-title">
                <a href={`/blog/${post.id}/`} class="t-text">{post.data.title}</a>
              </h2>
              <div class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </div>
              <div class="post-body">
                <p>{post.data.description}</p>
              </div>
            </article>
          </>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
